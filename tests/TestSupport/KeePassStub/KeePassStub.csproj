<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <AssemblyName>KeePass</AssemblyName>
    <RootNamespace>KeePass</RootNamespace>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <Description>Minimal KeePass type stubs for building PassKee.Plugin on non-Windows CI where KeePass.exe is unavailable.</Description>
  </PropertyGroup>

  <!-- WinForms UI stubs for KeePassUiTypes.cs — net48 only -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
